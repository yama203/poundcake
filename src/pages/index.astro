---
import Layout from "../layouts/layout.astro";
import EventView from "../components/EventView.astro";
import { getEvents, eventDescription } from "../lib/events";

const events = await getEvents();
const latest = events[events.length - 1];
const prev = events[events.length - 2];
---

<Layout description={eventDescription(latest)} image={latest.data.still ?? latest.data.flyer}>
  <EventView event={latest} prev={prev} />
</Layout>
